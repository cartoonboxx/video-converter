{
  "name": "video-to-mp4-ts",
  "version": "1.0.0",
  "description": "Simple desktop MOV/AVI to MP4 converter built with Electron and TypeScript",
  "main": "dist/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc && node scripts/copy-assets.cjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "^6.0.0"
  },
  "build": {
    "appId": "com.local.videotomp4",
    "productName": "Video to MP4",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video to MP4"
    }
  }
}
